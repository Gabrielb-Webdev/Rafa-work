<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 400">
  <defs>
    <linearGradient id="pillBlue" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" style="stop-color:#4DB8AC;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#3a9a8f;stop-opacity:1" />
    </linearGradient>
    <linearGradient id="pillWhite" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" style="stop-color:#ffffff;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#f0f0f0;stop-opacity:1" />
    </linearGradient>
    <filter id="pillShadow">
      <feDropShadow dx="3" dy="6" stdDeviation="5" flood-opacity="0.25"/>
    </filter>
  </defs>
  
  <rect width="800" height="400" fill="#f8f9fa"/>
  
  <!-- Píldoras azules -->
  <g filter="url(#pillShadow)">
    <ellipse cx="150" cy="200" rx="80" ry="35" fill="url(#pillBlue)"/>
    <rect x="70" y="165" width="160" height="70" rx="35" fill="url(#pillBlue)"/>
    <ellipse cx="230" cy="200" rx="80" ry="35" fill="url(#pillBlue)"/>
    <ellipse cx="150" cy="200" rx="80" ry="35" fill="rgba(255,255,255,0.2)"/>
  </g>
  
  <g filter="url(#pillShadow)">
    <ellipse cx="350" cy="250" rx="70" ry="30" fill="url(#pillBlue)" transform="rotate(25 350 250)"/>
    <rect x="280" y="220" width="140" height="60" rx="30" fill="url(#pillBlue)" transform="rotate(25 350 250)"/>
  </g>
  
  <!-- Píldoras blancas -->
  <g filter="url(#pillShadow)">
    <ellipse cx="550" cy="180" rx="75" ry="32" fill="url(#pillWhite)"/>
    <rect x="475" y="148" width="150" height="64" rx="32" fill="url(#pillWhite)"/>
    <ellipse cx="625" cy="180" rx="75" ry="32" fill="url(#pillWhite)"/>
  </g>
  
  <g filter="url(#pillShadow)">
    <ellipse cx="600" cy="300" rx="65" ry="28" fill="url(#pillWhite)" transform="rotate(-15 600 300)"/>
    <rect x="535" y="272" width="130" height="56" rx="28" fill="url(#pillWhite)" transform="rotate(-15 600 300)"/>
  </g>
  
  <g filter="url(#pillShadow)">
    <ellipse cx="250" cy="320" rx="60" ry="26" fill="url(#pillBlue)" transform="rotate(45 250 320)"/>
    <rect x="190" y="294" width="120" height="52" rx="26" fill="url(#pillBlue)" transform="rotate(45 250 320)"/>
  </g>
</svg>
