# Forethink Health - Configuración Apache

RewriteEngine On
RewriteBase /

# === No tocar archivos estáticos ni uploads ===
RewriteRule ^uploads/ - [L]
RewriteRule ^assets/ - [L]

# === URLs limpias ===

# Redirigir /index.php a /
RewriteCond %{THE_REQUEST} \s/index\.php[\s?] [NC]
RewriteRule ^index\.php$ / [R=301,L]

# Redirigir /pagina.php a /pagina (solo archivos raíz, no admin/ ni api/)
RewriteCond %{THE_REQUEST} \s/[^/]+\.php[\s?] [NC]
RewriteRule ^([^/]+)\.php$ /$1 [R=301,L]

# Servir /pagina internamente como /pagina.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([^/\.]+)/?$ $1.php [L]

# === Seguridad ===

# Proteger archivos de configuración
<FilesMatch "\.(env|ini|log|sql|bak|backup)$">
    Require all denied
</FilesMatch>

# Proteger config/database.php
<Files "database.php">
    Require all denied
</Files>
