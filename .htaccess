# Forethink Health - Configuración Apache

# Proteger archivos sensibles
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Proteger archivos de configuración
<FilesMatch "\.(env|ini|log|sql|bak|backup)$">
    Require all denied
</FilesMatch>

# Proteger config/database.php
<Files "database.php">
    Require all denied
</Files>

# Prevenir directory listing
Options -Indexes
