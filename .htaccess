# Forethink Health - Configuración Apache/LiteSpeed

# Habilitar RewriteEngine
RewriteEngine On
RewriteBase /

# Eliminar extensión .php - redirigir URLs con .php a URLs limpias
RewriteCond %{THE_REQUEST} \s/+([^.?]+)\.php[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# Servir archivos .php desde URLs sin extensión
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/%{REQUEST_URI}.php -f
RewriteRule ^(.+?)/?$ $1.php [L]

# Proteger archivos sensibles
<FilesMatch "\.(env|ini|log|sql|bak|backup)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Proteger config/database.php
<Files "database.php">
    Order allow,deny
    Deny from all
</Files>

# Prevenir directory listing
Options -Indexes
